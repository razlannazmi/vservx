# Copy to .env in this folder (backend/) and uncomment what you want to change.
# .env is read from the directory the app is started in. Real environment
# variables take precedence over values in this file.

# --- Server ---
# VSERVX_HOST=127.0.0.1
# VSERVX_PORT=5325

# Other origins allowed to call the API with a signed-in session (JSON list). Not needed for the
# web app: it's served by vservx itself, and the Vite dev server proxies /api. Every origin listed
# here can act as whoever is signed in, so list only ones you trust.
# VSERVX_CORS_ORIGINS=[]

# The built web app (`npm run build` in ui/), served at "/". Defaults to ui/dist in this repo.
# VSERVX_UI_DIR=../ui/dist

# --- Storage ---
# Holds vservx.db, secret.key (encrypts stored passwords and saved keys) and jwt.key.
# Back up secret.key: losing it makes stored passwords and saved keys unreadable.
# VSERVX_DATA_DIR=~/.config/vservx

# --- SSH ---
# Seconds allowed for each hop (jump host or server) to connect and log in.
# VSERVX_SSH_CONNECT_TIMEOUT=10

# --- Watching servers ---
# Every tested server is watched all the time over one kept-open SSH connection.
# VSERVX_WATCH_ENABLED=true
# How often usage, health and GPUs are read, and how often instances are looked for.
# VSERVX_USAGE_INTERVAL_SECONDS=5
# VSERVX_DISCOVERY_INTERVAL_SECONDS=60
# Minutes of usage history kept in memory for the charts (lost on restart).
# VSERVX_HISTORY_MINUTES=30
# Most servers doing SSH work at the same moment.
# VSERVX_WATCH_CONCURRENCY=8

# --- History store ---
# A PostgreSQL 14+ database where vservx keeps history across restarts: usage and GPU charts
# beyond VSERVX_HISTORY_MINUTES, state changes, model logs, the audit and its own log. Without
# it, history stays in memory. vservx creates its tables in an empty database.
# VSERVX_HISTORY_URL=postgresql://vservx:change-me@127.0.0.1:5432/vservx
# Days kept: raw readings, minute and hour rollups, model logs, vservx's own log, state changes, audit.
# VSERVX_HISTORY_RAW_DAYS=7
# VSERVX_HISTORY_MINUTE_DAYS=90
# VSERVX_HISTORY_HOUR_DAYS=365
# VSERVX_MODEL_LOG_DAYS=7
# VSERVX_APP_LOG_DAYS=30
# VSERVX_EVENT_DAYS=365
# VSERVX_AUDIT_DAYS=365
# Seconds between reads of each running instance's output.
# VSERVX_LOG_INTERVAL_SECONDS=15
# How the store reads, writes and looks after itself. The defaults suit most installs.
# Reads: each read's time limit; after this many failures in a row, how long reads skip the store;
# the most state changes one read returns.
# VSERVX_HISTORY_READ_TIMEOUT_SECONDS=3
# VSERVX_HISTORY_READ_FAILURES=3
# VSERVX_HISTORY_READ_PAUSE_SECONDS=30
# VSERVX_HISTORY_EVENT_LIMIT=2000
# Connecting: each attempt's time limit, the wait between attempts, and connections kept open.
# VSERVX_HISTORY_CONNECT_TIMEOUT_SECONDS=10
# VSERVX_HISTORY_RETRY_SECONDS=30
# VSERVX_HISTORY_POOL_SIZE=5
# Writing: the queue's size while the store is unreachable (oldest dropped beyond it), records
# per batch, seconds between flushes, the wait after a failed flush (doubling from min to max),
# and how long shutdown waits for the queue.
# VSERVX_HISTORY_QUEUE_MB=64
# VSERVX_HISTORY_BATCH_SIZE=1000
# VSERVX_HISTORY_FLUSH_SECONDS=2
# VSERVX_HISTORY_BACKOFF_MIN_SECONDS=1
# VSERVX_HISTORY_BACKOFF_MAX_SECONDS=60
# VSERVX_HISTORY_STOP_FLUSH_SECONDS=5
# Upkeep: day partitions made ahead, rows deleted per table per expiry run, seconds between
# partition and rollup runs and between expiry runs, and rollup buckets computed per run.
# VSERVX_HISTORY_PARTITION_DAYS_AHEAD=2
# VSERVX_HISTORY_DELETE_BATCH=10000
# VSERVX_HISTORY_MAINTAIN_SECONDS=60
# VSERVX_HISTORY_EXPIRE_SECONDS=3600
# VSERVX_HISTORY_ROLLUP_BUCKETS=1440

# --- Auth ---
# How long a sign-in lasts, in minutes (web app session cookie and API tokens). Default: 7 days.
# VSERVX_ACCESS_TOKEN_MINUTES=10080

# First-run admin account. Only used while there are no users in the database.
# Leave VSERVX_ADMIN_PASSWORD unset to have a random password generated and printed once at startup.
# VSERVX_ADMIN_NAME=Admin
# VSERVX_ADMIN_EMAIL=admin@example.com
# VSERVX_ADMIN_PASSWORD=
