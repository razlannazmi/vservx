# Copy to .env in this folder (backend/) and uncomment what you want to change.
# .env is read from the directory the app is started in. Real environment
# variables take precedence over values in this file.

# --- Server ---
# VSERVX_HOST=127.0.0.1
# VSERVX_PORT=8000

# Other origins allowed to call the API with a signed-in session (JSON list). Not needed for the
# web app: it's served by vservx itself, and the Vite dev server proxies /api. Every origin listed
# here can act as whoever is signed in, so list only ones you trust.
# VSERVX_CORS_ORIGINS=[]

# The built web app (`npm run build` in ui/), served at "/". Defaults to ui/dist in this repo.
# VSERVX_UI_DIR=../ui/dist

# --- Storage ---
# Holds vservx.db, secret.key (encrypts stored passwords and saved keys) and jwt.key.
# Back up secret.key: losing it makes stored passwords and saved keys unreadable.
# VSERVX_DATA_DIR=~/.config/vservx

# --- SSH ---
# Seconds allowed for each hop (jump host or server) to connect and log in.
# VSERVX_SSH_CONNECT_TIMEOUT=10

# --- Auth ---
# How long a sign-in lasts, in minutes (web app session cookie and API tokens). Default: 7 days.
# VSERVX_ACCESS_TOKEN_MINUTES=10080

# First-run admin account. Only used while there are no users in the database.
# Leave VSERVX_ADMIN_PASSWORD unset to have a random password generated and printed once at startup.
# VSERVX_ADMIN_NAME=Admin
# VSERVX_ADMIN_EMAIL=admin@example.com
# VSERVX_ADMIN_PASSWORD=
